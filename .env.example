# Copy to .env on the server, fill in the password, and keep it out of git.
#   cp .env.example /opt/zehnox/.env
#   chmod 600 /opt/zehnox/.env
#
# The site stores every inquiry in data/inquiries.json regardless. These settings only
# control the email copy sent to the address in the admin panel's "Forward inquiries to".
# With SMTP_USER/SMTP_PASS unset, the email is skipped and a warning is logged.

SMTP_HOST=mail.zehnox.com
SMTP_PORT=587
SMTP_USER=info@zehnox.com
SMTP_PASS=
SMTP_FROM=info@zehnox.com

# Set to 1 only if mail.zehnox.com uses a self-signed certificate. This disables
# certificate verification, so leave it unset whenever the certificate is trusted.
# SMTP_INSECURE_TLS=1
